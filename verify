#!/usr/bin/env bash
set -e

# Quality gate for the Chess Repertoire SRS fork (Lichess Mobile foundation).
# Uses FVM if a project pin exists, else falls back to PATH flutter.

FLUTTER="flutter"
if [ -x "$(command -v fvm)" ]; then
  FLUTTER="fvm flutter"
fi

echo "========================================="
echo " Chess Repertoire SRS - Quality Gate"
echo "========================================="

echo ""
echo "▶ 1. Static Analysis ($FLUTTER analyze)..."
$FLUTTER analyze

echo ""
echo "▶ 2. Automated Test Suite ($FLUTTER test)..."
$FLUTTER test

echo ""
echo "✅ All Quality Gates Passed Successfully!"
echo "========================================="
